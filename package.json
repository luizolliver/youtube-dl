{
  "name": "vela-downloader",
  "productName": "Vela",
  "version": "0.1.0",
  "description": "Baixe vídeos e playlists do YouTube e de centenas de outros sites, com a qualidade que você escolher.",
  "main": "src/main/main.js",
  "author": "Luiz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fetch-binaries": "node scripts/fetch-binaries.js",
    "dist": "node scripts/fetch-binaries.js --platform=win32 && electron-builder --win --x64",
    "check": "node --check src/main/main.js && node --check src/main/ytdlp.js && node --check src/main/downloads.js && node --check src/main/settings.js && node --check src/main/sites.js && node --check src/preload/preload.js && node --check src/renderer/app.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vela.downloader",
    "productName": "Vela",
    "copyright": "© 2026 Luiz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "yt-dlp*",
          "!*.download"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Vela-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vela",
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
